.DS_Store

# Local agent tooling — installed per-machine, not part of this project.
# Reinstall with: /plugin marketplace add … && /plugin install …
.agents/
skills-lock.json

# Claude Code: ignore installed skills and personal overrides,
# but allow a shared project settings.json (permissions, hooks) if one is added.
.claude/skills/
.claude/settings.local.json

# graphify knowledge-graph output (local build artifact)
graphify-out/

# node / next build artifacts
node_modules/
.next/
dist/
*.tsbuildinfo
.turbo/

# Local environment — never commit real values
.env
.env.local
!.env.example

# Test coverage output — regenerated by `pnpm exec vitest run --coverage`
coverage/

# Retrieved source artefacts. The raw store is immutable and content-addressed,
# but it is not repository content: it grows without bound (677,367 villages)
# and is reproducible from the source. Test fixtures are committed instead.
data/raw/*
!data/raw/.gitkeep

# Playwright run output — regenerated by `pnpm test:e2e`
test-results/
playwright-report/
