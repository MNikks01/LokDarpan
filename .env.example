# Local development. Copy to .env.local — which is gitignored and must never be committed.
# Host ports are 5433/6380 so LokDarpan can run alongside another project's
# Postgres or Redis on the default ports (see docker-compose.yml).
# ETL and migrations connect as the owner — the only write path to the ledger.
DATABASE_URL=postgresql://lokdarpan:lokdarpan_local_only@localhost:5433/lokdarpan

# The API connects as a role that cannot write. Create it once with:
#   docker exec -i lokdarpan-postgres psql -U lokdarpan -d lokdarpan \
#     < database/scripts/create-local-api-user.sql
DATABASE_URL_READONLY=postgresql://lokdarpan_api:lokdarpan_local_only@localhost:5433/lokdarpan
REDIS_URL=redis://localhost:6380

# Build identifier, echoed on every log line so a line maps to a deploy.
# Set this at deploy time; it defaults to "dev".
SERVICE_VERSION=dev
