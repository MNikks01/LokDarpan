# ── Public API ────────────────────────────────────────────────────────────────
# The read-only public API the web client consumes (.docs/11-api/).
LOKDARPAN_API_BASE_URL=http://localhost:4000/api/v1

# ── Web client ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are embedded in the browser bundle. They are PUBLIC.
# Never put a secret here — the app ships no client secrets by design
# (.docs/12-security/mobile-security.md §Authentication and storage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Serves fixtures instead of the API while the backend does not exist.
NEXT_PUBLIC_DATA_SOURCE=fixture

# ── ISR revalidation ──────────────────────────────────────────────────────────
# Shared secret for the ETL -> web revalidate webhook, fired on dataset.published.
REVALIDATE_SECRET=

# ── Datastore (services/*) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://lokdarpan:lokdarpan@localhost:5432/lokdarpan
REDIS_URL=redis://localhost:6379

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Object store for immutable, content-addressed source artifacts
# (.docs/04-data-engineering/data-collection-architecture.md).
ARTIFACT_STORE_URL=
# Optional: data.gov.in API key. Only official government sources are ingested.
DATA_GOV_IN_API_KEY=

# ── AI layer (optional) ───────────────────────────────────────────────────────
# The AI layer is guardrailed and vendor-pluggable (.docs/09-ai/ai-layer.md).
AI_PROVIDER=
AI_API_KEY=
