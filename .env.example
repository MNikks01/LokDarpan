# Local development. Copy to .env.local — which is gitignored and must never be committed.
# Host ports are 5433/6380 so LokDarpan can run alongside another project's
# Postgres or Redis on the default ports (see docker-compose.yml).
DATABASE_URL=postgresql://lokdarpan:lokdarpan_local_only@localhost:5433/lokdarpan
REDIS_URL=redis://localhost:6380
